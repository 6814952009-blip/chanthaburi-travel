{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "client/dist",
    "functions": {
        "server/api/index.js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/server/api/index"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}